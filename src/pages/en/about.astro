---
import { getPagePath } from '../../data';
import { getMessages } from '../../i18n';
import SiteLayout from '../../layouts/SiteLayout.astro';
import AboutView from '../../views/AboutView.astro';

const lang = 'en' as const;
const copy = getMessages(lang);
const zhPath = getPagePath('about', 'zh');
const enPath = getPagePath('about', 'en');
---

<SiteLayout
  alternate={{ zh: zhPath, en: enPath }}
  canonicalPath={enPath}
  currentPage="about"
  description={copy.about.metaDescription}
  lang={lang}
  languagePath={zhPath}
  title={copy.about.metaTitle}
>
  <AboutView lang={lang} />
</SiteLayout>
