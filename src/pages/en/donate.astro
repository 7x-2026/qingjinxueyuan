---
import { getPagePath } from '../../data';
import { getMessages } from '../../i18n';
import SiteLayout from '../../layouts/SiteLayout.astro';
import DonateView from '../../views/DonateView.astro';

const lang = 'en' as const;
const copy = getMessages(lang);
const zhPath = getPagePath('donate', 'zh');
const enPath = getPagePath('donate', 'en');
---

<SiteLayout
  alternate={{ zh: zhPath, en: enPath }}
  canonicalPath={enPath}
  currentPage="donate"
  description={copy.donate.metaDescription}
  lang={lang}
  languagePath={zhPath}
  title={copy.donate.metaTitle}
>
  <DonateView lang={lang} />
</SiteLayout>
