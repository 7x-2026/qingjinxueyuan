---
import {
  assertHetuRouteSlugs,
  getHetuPath,
  hetuPages,
  publicHetuSlugs,
  site,
} from '../../../data';
import { localize } from '../../../i18n';
import type { HetuPage } from '../../../data';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import HetuDetailView from '../../../views/HetuDetailView.astro';

export function getStaticPaths() {
  assertHetuRouteSlugs(publicHetuSlugs);
  return hetuPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: HetuPage;
}

const { page } = Astro.props as Props;
const lang = 'en' as const;
const zhPath = getHetuPath('zh', page.slug);
const enPath = getHetuPath('en', page.slug);
const title = `${localize(page.title, lang)} | World HeTu Chinese Education Institute | ${site.name}`;
---

<SiteLayout
  alternate={{ zh: zhPath, en: enPath }}
  canonicalPath={enPath}
  description={localize(page.summary, lang)}
  lang={lang}
  languagePath={zhPath}
  title={title}
>
  <HetuDetailView lang={lang} page={page} />
</SiteLayout>
