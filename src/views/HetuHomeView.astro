---
import { Image } from 'astro:assets';
import {
  getHetuPath,
  hetuInstituteIntroduction,
  hetuOverview,
  hetuPages,
} from '../data';
import { localize } from '../i18n';
import type { Language } from '../data';
import Icon from '../components/Icon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const labels =
  lang === 'zh'
    ? {
        introduction: '一. 世界和图中文教育学会介绍',
        explore: '二. 世界和图中文课程介绍',
        readMore: '阅读详情',
      }
    : {
        introduction: 'I. About the World HeTu Chinese Education Institute',
        explore: 'II. World HeTu Chinese Courses',
        readMore: 'Read more',
      };
---

<section class="section hetu-overview" data-hetu-overview>
  <div class="page-shell">
    <header class="hetu-overview__hero">
      <div class="hetu-overview__image">
        <Image
          alt={localize(hetuOverview.image.alt, lang)}
          loading="eager"
          sizes="(max-width: 680px) 76vw, 340px"
          src={hetuOverview.image.image}
          widths={[320, 480, 640]}
        />
      </div>
      <div>
        <h1>{localize(hetuOverview.title, lang)}</h1>
        <p class="hetu-overview__lead">
          {localize(hetuOverview.description, lang)}
        </p>
      </div>
    </header>

    <section
      class="hetu-overview__introduction"
      aria-labelledby="hetu-introduction-title"
    >
      <div class="hetu-overview__section-heading">
        <h2 id="hetu-introduction-title">{labels.introduction}</h2>
      </div>
      <div class="hetu-overview__introduction-content">
        {
          hetuInstituteIntroduction.map((section) => (
            <section class="hetu-overview__introduction-section">
              <h3>{localize(section.heading, lang)}</h3>
              {section.paragraphs?.map((paragraph) => (
                <p>{localize(paragraph, lang)}</p>
              ))}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => (
                    <li>{localize(bullet, lang)}</li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="hetu-sections-title">
      <div class="hetu-overview__section-heading">
        <h2 id="hetu-sections-title">{labels.explore}</h2>
      </div>
      <div class="hetu-card-grid">
        {
          hetuPages.map((page) => (
            <a class="hetu-card" href={getHetuPath(lang, page.slug)}>
              <span class="hetu-card__number">
                {String(page.order).padStart(2, '0')}
              </span>
              <h3>{localize(page.title, lang)}</h3>
              <p>{localize(page.summary, lang)}</p>
              <span class="hetu-card__action">
                {labels.readMore} <Icon name="arrow-right" size={17} />
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</section>
